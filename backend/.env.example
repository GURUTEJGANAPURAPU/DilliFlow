# Transport Stack GTFS-Realtime API key. Set locally; never commit this file.
TRANSPORT_STACK_API_KEY=

# Data files (paths relative to backend/ unless absolute)
GTFS_ZIP_PATH=./data/raw/delhi_buses_static_gtfs_v1.zip
TICKET_ZIP_PATH=./data/raw/October-Delhi.csv.zip
DILLIFLOW_DB_PATH=./data/processed/dilliflow.sqlite

# API settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POLL_INTERVAL_SECONDS=30
LIVE_FEED_TIMEOUT_SECONDS=40
STALE_AFTER_SECONDS=300
APP_TIMEZONE=Asia/Kolkata

# Operator workspace authentication. Leave blank to disable operator sign-in until configured.
# Commuter pages do not require login.
OPERATOR_ID=
OPERATOR_PASSWORD=
OPERATOR_TOKEN_SECRET=
OPERATOR_TOKEN_TTL_SECONDS=28800
